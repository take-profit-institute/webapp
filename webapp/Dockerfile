# webapp 정적 번들 이미지 (Next output=export → nginx).
# 빌드 컨텍스트는 모노레포 루트(webapp/)여야 한다:
#   docker build -f webapp/Dockerfile -t <user>/candle-webapp:dev \
#     --build-arg NEXT_PUBLIC_API_BASE_URL=https://api.lite.candle.io.kr .
#
# ⚠️ NEXT_PUBLIC_*는 정적 export 시점에 번들로 박힌다 → 환경마다 이미지를 따로 빌드해야 한다.
#    (S3+CloudFront 배포에서 CI가 env로 주던 값을 여기서는 build-arg로 받는다)
FROM node:20-alpine AS build
WORKDIR /app

# 워크스페이스 그래프 해석용 package.json들 + lockfile 먼저(레이어 캐시)
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY bff/package.json bff/
COPY webapp/package.json webapp/
COPY admin/package.json admin/
RUN npm ci

COPY shared shared
COPY webapp webapp

ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_AUTH_BASE_URL
ARG NEXT_PUBLIC_WS_BASE_URL
ARG NEXT_PUBLIC_CHAT_API_BASE_URL
ARG NEXT_PUBLIC_CHAT_WS_BASE_URL
ARG NEXT_PUBLIC_OAUTH_REDIRECT_BRIDGE_URL
ARG NEXT_PUBLIC_OAUTH_NATIVE_REDIRECT_URI
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ARG NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID
ARG NEXT_PUBLIC_FIREBASE_VAPID_KEY
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_AUTH_BASE_URL=$NEXT_PUBLIC_AUTH_BASE_URL \
    NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL \
    NEXT_PUBLIC_CHAT_API_BASE_URL=$NEXT_PUBLIC_CHAT_API_BASE_URL \
    NEXT_PUBLIC_CHAT_WS_BASE_URL=$NEXT_PUBLIC_CHAT_WS_BASE_URL \
    NEXT_PUBLIC_OAUTH_REDIRECT_BRIDGE_URL=$NEXT_PUBLIC_OAUTH_REDIRECT_BRIDGE_URL \
    NEXT_PUBLIC_OAUTH_NATIVE_REDIRECT_URI=$NEXT_PUBLIC_OAUTH_NATIVE_REDIRECT_URI \
    NEXT_PUBLIC_FIREBASE_API_KEY=$NEXT_PUBLIC_FIREBASE_API_KEY \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=$NEXT_PUBLIC_FIREBASE_PROJECT_ID \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID \
    NEXT_PUBLIC_FIREBASE_APP_ID=$NEXT_PUBLIC_FIREBASE_APP_ID \
    NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID \
    NEXT_PUBLIC_FIREBASE_VAPID_KEY=$NEXT_PUBLIC_FIREBASE_VAPID_KEY

# build:app = NEXT_OUTPUT=export NEXT_PUBLIC_STATIC_EXPORT=true next build → webapp/out
RUN npm run build -w @candle/shared && npm run build:app -w @candle/webapp

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx-static.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/webapp/out /usr/share/nginx/html
EXPOSE 80
